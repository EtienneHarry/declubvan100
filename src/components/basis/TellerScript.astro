---
/**
 * Het script achter Teller.tsx.
 *
 * Apart bestand omdat Teller een React-component is: een <script> daarin zou
 * inline in de HTML belanden en op `script-src 'self'` stuklopen. Hier maakt
 * Astro er een gewoon bestand van.
 *
 * Staat in de layout en dus op elke pagina. Hij doet niets zolang er geen
 * [data-teller] op de pagina staat, en dat scheelt uitzoeken welke pagina er
 * wel of niet een heeft.
 */
---

<script>
  const teller = document.querySelector<HTMLElement>('[data-teller]');

  if (teller) {
    const doel = Number(teller.textContent);

    // Gereduceerde beweging: het getal staat al goed, dus we laten het staan.
    // Niet "heel snel tellen" — dat is precies wat deze bezoeker niet vraagt.
    const rustig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /*
     * Eén keer per bezoek, niet één keer per paginalading. Wie tijdens dezelfde
     * sessie terugkomt op de home heeft de telling al gezien; dan staat er
     * meteen 100. sessionStorage en niet localStorage, want een nieuw bezoek
     * mag hem wél opnieuw krijgen — en het zit in een try, want in een privé-
     * venster kan elke toegang gooien en dan telt hij gewoon weer.
     */
    const alGeteld = (() => {
      try {
        return window.sessionStorage.getItem('teller-geteld') === 'ja';
      } catch {
        return false;
      }
    })();

    if (Number.isFinite(doel) && !rustig && !alGeteld) {
      /*
       * Duur en curve komen uit de tokenlaag, niet uit dit bestand. --duur-4 is
       * in het design system de duur voor "beeld dat in beeld komt", en dat is
       * precies wat hier gebeurt.
       */
      const stijl = getComputedStyle(document.documentElement);
      const duur = Number.parseFloat(stijl.getPropertyValue('--duur-4'));
      const curve = stijl.getPropertyValue('--soepel-uit');

      /**
       * Dezelfde curve als de CSS, maar dan in JavaScript. We animeren tekst en
       * geen stijl, dus de browser kan het niet voor ons doen.
       *
       * Newton-Raphson op de x-as om t te vinden, daarna y uitrekenen. Vijf
       * stappen is ruim genoeg voor een curve die tussen 0 en 1 loopt.
       */
      function versoepel(x1: number, y1: number, x2: number, y2: number) {
        const a = (p: number, q: number) => 1 - 3 * q + 3 * p;
        const b = (p: number, q: number) => 3 * q - 6 * p;
        const c = (p: number) => 3 * p;

        const bij = (t: number, p: number, q: number) =>
          ((a(p, q) * t + b(p, q)) * t + c(p)) * t;
        const helling = (t: number, p: number, q: number) =>
          3 * a(p, q) * t * t + 2 * b(p, q) * t + c(p);

        return (x: number) => {
          let t = x;

          for (let i = 0; i < 5; i++) {
            const h = helling(t, x1, x2);
            if (h === 0) break;
            t -= (bij(t, x1, x2) - x) / h;
          }

          return bij(t, y1, y2);
        };
      }

      const punten = /cubic-bezier\(([^)]+)\)/.exec(curve);
      const [x1, y1, x2, y2] = punten
        ? punten[1].split(',').map((deel) => Number.parseFloat(deel))
        : [0, 0, 1, 1];

      const soepel = versoepel(x1 ?? 0, y1 ?? 0, x2 ?? 1, y2 ?? 1);

      let gestart = false;

      function tel() {
        try {
          window.sessionStorage.setItem('teller-geteld', 'ja');
        } catch {
          // Geen opslag is geen bezwaar; dan telt hij volgende keer opnieuw.
        }

        const begin = performance.now();

        function stap(nu: number) {
          const verstreken = Math.min((nu - begin) / duur, 1);
          teller!.textContent = String(Math.round(soepel(verstreken) * doel));

          if (verstreken < 1) requestAnimationFrame(stap);
          // Aan het eind precies het doel, niet wat de afronding oplevert.
          else teller!.textContent = String(doel);
        }

        teller!.textContent = '0';
        requestAnimationFrame(stap);
      }

      /*
       * Eén keer per paginabezoek. De waarnemer stopt zichzelf zodra hij is
       * afgegaan, dus terugscrollen laat de kop niet opnieuw tellen.
       */
      const waarnemer = new IntersectionObserver(
        (ingangen) => {
          for (const ingang of ingangen) {
            if (!ingang.isIntersecting || gestart) continue;
            gestart = true;
            waarnemer.disconnect();
            tel();
          }
        },
        { threshold: 0.5 },
      );

      waarnemer.observe(teller);
    }
  }
</script>
