---
/**
 * Het accordeon: dichtklappen en openklappen.
 *
 * Apart Astro-bestand, net als TellerScript, OnthulScript en HaalScript: een
 * <script> in een React-component belandt inline in de HTML en loopt op
 * `script-src 'self'` stuk. Hier maakt Astro er een gewoon bestand van.
 *
 * DIT SCRIPT KLAPT EERST ALLES DICHT. In de HTML staan de antwoorden open, want
 * zonder JavaScript hoort de sectie een gewone lijst met vragen en antwoorden te
 * zijn. Pas als dit script draait, wordt het een accordeon.
 *
 * Het staat in de layout en dus op elke pagina. Zonder [data-accordeon-item]
 * doet het niets.
 */
---

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-accordeon-item]'));

  if (items.length > 0) {
    /**
     * Eén vraag open- of dichtzetten.
     *
     * Drie dingen tegelijk, en ze horen bij elkaar: het attribuut waar de CSS op
     * kijkt, de toestand die een schermlezer voorleest, en `inert` op het
     * paneel. Dat laatste is niet optioneel — een dichtgeklapt paneel staat op
     * `grid-template-rows: 0fr` met `overflow: hidden`, en dat haalt de links
     * erin niet uit de tab-volgorde. Zonder inert tabt de bezoeker door
     * antwoorden die hij niet ziet.
     */
    function zet(item: HTMLElement, open: boolean) {
      const knop = item.querySelector<HTMLButtonElement>('[data-accordeon-knop]');
      const paneel = item.querySelector<HTMLElement>('[data-accordeon-paneel]');
      if (!knop || !paneel) return;

      if (open) delete item.dataset.accordeonDicht;
      else item.dataset.accordeonDicht = '';

      knop.setAttribute('aria-expanded', String(open));
      paneel.inert = !open;
    }

    /*
     * Alles dicht bij het laden, en zónder overgang.
     *
     * De overgang staat als transitie op het paneel, dus als we hier gewoon
     * dichtzetten, klapt elk antwoord bij het laden van de pagina zichtbaar
     * omhoog. Dat is beweging die niemand heeft aangevraagd. Het attribuut
     * hieronder zet die transitie uit tot het eerste beeldje voorbij is.
     */
    document.documentElement.dataset.accordeonStil = '';

    for (const item of items) zet(item, false);

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        delete document.documentElement.dataset.accordeonStil;
      });
    });

    /*
     * Eén luisteraar voor de hele pagina in plaats van één per knop. Er staan er
     * twaalf op een pagina en er kunnen er meer bij komen; dit schaalt zonder
     * dat iemand eraan hoeft te denken.
     */
    document.addEventListener('click', (gebeurtenis) => {
      const doel = gebeurtenis.target;
      if (!(doel instanceof Element)) return;

      const knop = doel.closest('[data-accordeon-knop]');
      if (!knop) return;

      const item = knop.closest<HTMLElement>('[data-accordeon-item]');
      if (!item) return;

      /*
       * Eén tegelijk open of meerdere? Meerdere. Een bezoeker die twee vragen
       * naast elkaar wil vergelijken, hoort dat te kunnen; en een accordeon die
       * bij elke klik iets anders dichtklapt, verschuift de pagina onder de
       * muis vandaan.
       */
      zet(item, item.dataset.accordeonDicht !== undefined);
    });
  }
</script>
