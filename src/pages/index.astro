---
import Basis from '../layouts/Basis.astro';
import SectionRenderer from '../lib/SectionRenderer';
import { leesPagina } from '../lib/pagina';

/*
 * Home.
 *
 * De inhoud komt uit het CMS: src/content/paginas/home.yaml.
 *
 * De klant noemt zelf jongensvandebar.nl als referentie: een splitscreen met
 * twee deuren. Die twee deuren staan direct onder de hero, met de knopteksten
 * uit de microcopy-tabel — "Ik zoek personeel" en "Ik wil bij jullie werken",
 * niet "Meer informatie" en "Solliciteer nu".
 *
 * De foto's van die twee deuren staan niet in het CMS maar in
 * src/lib/pagina.ts. Welke foto bij welke deur hoort is een ontwerpbeslissing
 * en geen redactionele; de redacteur verzet de tekst, niet het beeld.
 */

const { titel, beschrijving, secties } = await leesPagina('home');
---

<Basis titel={titel} beschrijving={beschrijving}>
  {secties.map((sectie) => <SectionRenderer sectie={sectie} />)}
</Basis>
