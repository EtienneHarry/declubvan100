---
import Basis from '../layouts/Basis.astro';
import SectionRenderer, { type Sectie } from '../lib/SectionRenderer';

/*
 * Voorwaarden — de enige lichte pagina.
 *
 * Papier met de smalle container: lopende tekst leest op licht tot 66ch, en
 * dat is precies waar `smal` en `maatRegelKlasse` samen op uitkomen. De
 * secties zetten zelf data-thema="licht", zodat de semantische aliassen
 * meekantelen.
 *
 * PLAATSHOUDER — de echte voorwaardentekst ontbreekt. De pdf is buiten deze
 * repo gehouden, dus er staat hier niets samengevats of nagemaakts: dat zou
 * juridische tekst worden die niemand heeft goedgekeurd. Zodra de tekst er is
 * vervangt hij de twee alinea's hieronder, als kop- en alineablokken.
 *
 * schichtLijst blijft uit zodra er lijsten in komen: de opsommingsschicht is
 * volgens de richtlijn alleen voor lijsten over de 100 of de selectie, niet
 * voor een artikelopsomming.
 */

const secties: Sectie[] = [
  {
    type: 'hero',
    achtergrond: 'papier',
    ruimte: 'sectie-l',
    breedte: 'smal',
    bovenkop: 'Voorwaarden',
    kop: 'Algemene voorwaarden',
    tekst: 'Deze pagina wacht op de definitieve tekst.',
  },
  {
    type: 'rijke-tekst',
    achtergrond: 'papier',
    ruimte: 'sectie-m',
    breedte: 'smal',
    blokken: [
      {
        soort: 'alinea',
        tekst:
          'De algemene voorwaarden van De Club van 100 staan nog niet op deze pagina. De tekst wordt nageleverd en komt hier ongewijzigd te staan.',
      },
      {
        soort: 'alinea',
        tekst: 'Heb je ze nu nodig, mail dan naar info@declubvan.nl.',
      },
    ],
  },
];
---

<Basis
  titel="Algemene voorwaarden — De Club van 100"
  beschrijving="De algemene voorwaarden van De Club van 100. De definitieve tekst wordt nageleverd."
>
  {secties.map((sectie) => <SectionRenderer sectie={sectie} />)}
</Basis>
