---
import Basis from '../layouts/Basis.astro';
import SectionRenderer from '../lib/SectionRenderer';
import { leesPagina } from '../lib/pagina';

/*
 * Voorwaarden — de enige lichte pagina.
 *
 * De inhoud komt uit het CMS: src/content/paginas/voorwaarden.yaml. De tekst
 * van de acht artikelen staat daar als markdown, letterlijk overgenomen uit
 * bron/voorwaarden.md.
 *
 * ===========================================================================
 * NIET LIVE ZETTEN — punt 6 verwijst naar een privacyverklaring die nog niet
 * bestaat. Die verwijzing staat er bewust zonder link: een dode link is erger
 * dan geen link, en beide zijn onacceptabel op een pagina die naar
 * privacywetgeving verwijst. Zeker nu het aanmeldformulier eraan komt en er
 * dus persoonsgegevens verwerkt gaan worden.
 *
 * Voordat deze site live gaat moet er een privacyverklaring zijn en moet punt
 * 6 daarnaartoe wijzen. Zie ook de openstaande punten in CLAUDE.md.
 * ===========================================================================
 */

const { titel, beschrijving, secties } = await leesPagina('voorwaarden');
---

<Basis titel={titel} beschrijving={beschrijving}>
  {secties.map((sectie) => <SectionRenderer sectie={sectie} />)}
</Basis>
