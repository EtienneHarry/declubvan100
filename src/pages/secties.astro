        achtergrond: 'roet',
        ruimte: 'sectie-s',
        breedte: 'breed',
        deuren: [
          { kop: 'Opdrachtgevers', tekst: '', beeld: BEELD },
          { kop: 'Professionals', tekst: '', beeld: BEELD },
        ],
      },
      {
        type: 'kop-tekst',
        achtergrond: 'bruin',
        ruimte: 'sectie-s',
        breedte: 'smal',
        kop: 'Een gewone kop',
        tekst: '',
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'mist',
        ruimte: 'sectie-s',
        breedte: 'basis',
        kop: 'Een gewone kop',
        tekst: '',
        beeld: BEELD,
        beeldPositie: 'rechts',
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'bruin',
        ruimte: 'sectie-s',
        breedte: 'basis',
        items: kolommen(3, false),
      },
      {
        type: 'citaten',
        achtergrond: 'papier',
        ruimte: 'sectie-s',
        breedte: 'basis',
        items: [{ citaat: 'Ze stonden er op tijd.' }],
      },
      {
        type: 'oproep',
        achtergrond: 'roet',
        ruimte: 'sectie-s',
        breedte: 'basis',
        kop: 'Een gewone kop',
        tekst: '',
        knop: { label: 'Stuur maar', href: '/contact' },
      },
      {
        type: 'rijke-tekst',
        achtergrond: 'bruin',
        ruimte: 'sectie-s',
        breedte: 'smal',
        inhoud: Markdoc.parse(''),
      },
    ],
  },
  {
    naam: 'weinig items',
    secties: [
      {
        type: 'hero',
        achtergrond: 'papier',
        ruimte: 'sectie-l',
        breedte: 'smal',
        kop: 'Alleen een kop',
      },
      {
        type: 'splitscreen',
        achtergrond: 'bruin',
        ruimte: 'sectie-l',
        breedte: 'basis',
        deuren: [
          {
            kop: 'Eén enkele deur',
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
