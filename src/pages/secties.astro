  },
  {
    naam: 'regressie · twee openingssecties',
    secties: [
      {
        type: 'hero',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Eerste',
        kop: 'Deze blijft h1 en display-xl',
        tekst: LOPENDE_TEKST,
      },
      {
        // Tweede hero: geen tweede h1 en geen tweede display-xl. Hij zakt naar
        // een gewone sectiekop op display-l.
        type: 'hero',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Tweede',
        kop: 'Deze zakt naar h2 en display-l',
        tekst: LOPENDE_TEKST,
      },
    ],
  },
  {
    /*
     * De teller in de openingskop. Twee heroes naast elkaar: één met een getal
     * en één zonder.
     *
     * Waar je op let: in de broncode staat 100 en niet 0 — het script telt
     * ernaartoe, niet ervandaan. De kop mag niet wiebelen terwijl hij telt; de
     * breedte van drie cijfers is gereserveerd met --maat-teller plus
     * tabular-nums. En de kop zonder getal hoort geen extra elementen te
     * krijgen.
     */
    naam: 'teller · kop met en zonder getal',
    secties: [
      {
        type: 'hero',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Met getal',
        kop: 'Een van de 100',
        tekst: LOPENDE_TEKST,
      },
      {
        type: 'hero',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Zonder getal',
        kop: 'Honderd plekken',
        tekst: LOPENDE_TEKST,
      },
    ],
  },
  {
    /*
     * Beweging. Deze pagina is de enige plek waar elk sectietype in bewegende
     * toestand langskomt; op de zes echte pagina's staat nooit alles bij elkaar.
     *
     * Waar je op let, en dat is niet te zien op een screenshot — scroll ernaar
     * toe en kijk:
     *
     *   - de ploeg loopt door: bovenkop, kop, dan kaart na kaart, 70ms uit
     *     elkaar. Vanaf de negende kaart delen ze de laatste stap.
     *   - de kop fadet niet in maar komt uit een masker omhoog, en de staarten
     *     van de p en de g blijven heel in het laatste beeldje.
     *   - de linkerdeur zoomt onder de muis, de rechter niet: die heeft geen
     *     knop en verwijst dus nergens naar.
     *   - niets verspringt. De onthulling loopt op transform en opacity, dus de
     *     hoogte van de pagina verandert er niet van.
     *
     * Met "beweging beperken" aan in het systeem staat alles er meteen: geen
     * verschuiving, geen wachttijd, geen masker en geen zoom.
     */
    naam: 'beweging · onthulling, ritme en zoom',
    secties: [
      {
        type: 'drie-kolommen',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Het ritme',
