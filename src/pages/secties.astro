        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'basis',
        deuren: [
          {
            bovenkop: 'Met knop',
            kop: 'Deze deur zoomt onder de muis',
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
