---
import Basis from '../layouts/Basis.astro';
import { SectieLijst, type Sectie } from '../lib/SectionRenderer';
import Markdoc from '@markdoc/markdoc';

import foto from '../assets/photo/proost-tap.jpg';

/*
 * Beheerbaarheidstest.
 *
 * Elk van de zeven sectietypes vier keer, onder de omstandigheden waar een
 * sjabloon normaal op stukloopt: een te lange kop, een lege tekst, weinig items
 * en veel items. Bij beeld-tekst en splitscreen komt op de vierde plek een
 * ontbrekende afbeelding in plaats van veel items.
 *
 * Niet elk type heeft items. Bij kop-tekst, beeld-tekst en oproep vertalen
 * "weinig" en "veel" zich naar de hoeveelheid tekst en het aantal optionele
 * onderdelen — dat is daar het equivalent van een leeg of overvol blok.
 *
 * De achtergrondtokens wisselen per geval, zodat zichtbaar wordt of secties in
 * willekeurige volgorde naast elkaar blijven kloppen en of het lichte thema
 * meekantelt.
 *
 * Onderaan staat een vijfde blok dat geen variant is maar een regressietest:
 * één splitscreen met een extreem lange kop, die de overflow-bug in Beeldvlak
 * moet blootleggen zodra iemand daar grid-cols-1 of w-full weghaalt.
 */

const LANGE_KOP =
  'Een kop die bewust veel te lang is gemaakt om te zien of hij netjes over meerdere regels afbreekt in plaats van uit zijn sectie te lopen of het raster op te rekken';

const LOPENDE_TEKST =
  'Iedereen die hier staat, heeft honderd avonden achter een bar gestaan. Wij regelen de mensen, jij regelt de rest.';

const LANGE_TEKST = `${LOPENDE_TEKST} ${LOPENDE_TEKST} ${LOPENDE_TEKST}`;

const BEELD = { bron: foto.src, alt: 'Twee mensen proosten aan de buitenbar' };

/*
 * Een staande foto, rechtstreeks uit public/beeld en dus langs Astro's
 * beeldpijplijn heen — precies zoals een foto die de redacteur in het CMS
 * kiest. Het merendeel van de aangeleverde fotografie is 1333x2000.
 */
const STAAND_BEELD = {
  bron: '/beeld/staff-wanted.jpg',
  alt: 'Aanplakbiljet met de tekst staff wanted tegen een muur',
};

/*
 * Regressie. Beeldvlak sneed inhoud af zolang het een vaste verhouding met
 * absoluut gepositioneerde tekst was: op 375px verdween hier 309px kop en tekst
 * boven de rand. De reparatie hangt aan grid-cols-1 en w-full in Beeldvlak, en
 * die zien er allebei weglaatbaar uit.
 *
 * Deze kop is expres extreem. Op 375px moet hij het vlak laten meegroeien —
 * niets afgesneden, niets buiten de viewport.
 */
const REGRESSIE_KOP =
  'Een kop die zo lang is dat hij op een telefoon acht of negen regels beslaat en daarmee ver voorbij de zestien-negen-verhouding van het beeldvlak groeit, wat precies de situatie is waarin de inhoud vroeger stilzwijgend werd weggeknipt in plaats van het vlak te laten meegroeien';

function kolommen(aantal: number, metTekst = true) {
  return Array.from({ length: aantal }, (_, index) => ({
    nummer: String(index + 1).padStart(2, '0'),
    kop: `Kaart ${index + 1}`,
    tekst: metTekst ? 'Tappen onder druk, cocktails, opbouw en afbouw.' : '',
  }));
}

function citaten(aantal: number) {
  return Array.from({ length: aantal }, (_, index) => ({
    citaat: `Ze stonden er op tijd en ze wisten wat ze deden. Citaat ${index + 1}.`,
    naam: `Opdrachtgever ${index + 1}`,
    rol: 'Festivalorganisatie',
  }));
}

const gevallen: { naam: string; secties: Sectie[] }[] = [
  {
    naam: 'te lange kop',
    secties: [
      {
        type: 'hero',
        achtergrond: 'inkt',
        ruimte: 'sectie-l',
        breedte: 'basis',
        bovenkop: 'Een bovenkop die ook al aan de lange kant is',
        kop: LANGE_KOP,
        tekst: LOPENDE_TEKST,
        knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
        tweedeKnop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
        schicht: true,
      },
      {
        type: 'splitscreen',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        deuren: [
          {
            bovenkop: 'Opdrachtgevers',
            kop: LANGE_KOP,
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
            beeld: BEELD,
          },
          {
            bovenkop: 'Professionals',
            kop: LANGE_KOP,
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
            beeld: BEELD,
          },
        ],
      },
      {
        type: 'kop-tekst',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Over ons',
        kop: LANGE_KOP,
        tekst: LOPENDE_TEKST,
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Werkwijze',
        kop: LANGE_KOP,
        tekst: LOPENDE_TEKST,
        beeld: BEELD,
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'papier',
        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: LANGE_KOP,
        items: kolommen(3),
      },
      {
        type: 'citaten',
        achtergrond: 'mist',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Wat ze zeggen',
        items: [{ citaat: LANGE_KOP, naam: 'Een opdrachtgever', rol: 'Horeca' }],
      },
      {
        type: 'oproep',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: LANGE_KOP,
        tekst: LOPENDE_TEKST,
        knop: { label: 'Ik zoek personeel', href: '/contact' },
      },
      {
        type: 'rijke-tekst',
        achtergrond: 'papier',
        ruimte: 'sectie-m',
        breedte: 'smal',
        kop: LANGE_KOP,
        inhoud: Markdoc.parse(`## ${LANGE_KOP}\n\n${LOPENDE_TEKST}`),
      },
    ],
  },
  {
    naam: 'lege tekst',
    secties: [
      {
        // Met beeld loopt de kop door Beeldvlak. schicht staat hier expres aan:
        // beeld wint, de schicht hoort dan niet te verschijnen.
        type: 'hero',
        achtergrond: 'inkt',
        ruimte: 'sectie-s',
        breedte: 'basis',
        kop: 'Een van de 100',
        tekst: '',
        beeld: BEELD,
        schicht: true,
      },
      {
        type: 'splitscreen',
        achtergrond: 'roet',
        ruimte: 'sectie-s',
        breedte: 'breed',
        deuren: [
          { kop: 'Opdrachtgevers', tekst: '', beeld: BEELD },
          { kop: 'Professionals', tekst: '', beeld: BEELD },
        ],
      },
      {
        type: 'kop-tekst',
        achtergrond: 'inkt',
        ruimte: 'sectie-s',
        breedte: 'smal',
        kop: 'Een gewone kop',
        tekst: '',
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'mist',
        ruimte: 'sectie-s',
        breedte: 'basis',
        kop: 'Een gewone kop',
        tekst: '',
        beeld: BEELD,
        beeldPositie: 'rechts',
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'inkt',
        ruimte: 'sectie-s',
        breedte: 'basis',
        items: kolommen(3, false),
      },
      {
        type: 'citaten',
        achtergrond: 'papier',
        ruimte: 'sectie-s',
        breedte: 'basis',
        items: [{ citaat: 'Ze stonden er op tijd.' }],
      },
      {
        type: 'oproep',
        achtergrond: 'roet',
        ruimte: 'sectie-s',
        breedte: 'basis',
        kop: 'Een gewone kop',
        tekst: '',
        knop: { label: 'Stuur maar', href: '/contact' },
      },
      {
        type: 'rijke-tekst',
        achtergrond: 'inkt',
        ruimte: 'sectie-s',
        breedte: 'smal',
        inhoud: Markdoc.parse(''),
      },
    ],
  },
  {
    naam: 'weinig items',
    secties: [
      {
        type: 'hero',
        achtergrond: 'papier',
        ruimte: 'sectie-l',
        breedte: 'smal',
        kop: 'Alleen een kop',
      },
      {
        type: 'splitscreen',
        achtergrond: 'inkt',
        ruimte: 'sectie-l',
        breedte: 'basis',
        deuren: [
          {
            kop: 'Eén enkele deur',
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
            beeld: BEELD,
          },
        ],
      },
      {
        type: 'kop-tekst',
        achtergrond: 'papier',
        ruimte: 'sectie-l',
        breedte: 'smal',
        kop: 'Alleen een kop',
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'roet',
        ruimte: 'sectie-l',
        breedte: 'basis',
        kop: 'Alleen een kop en beeld',
        beeld: BEELD,
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'inkt',
        ruimte: 'sectie-l',
        breedte: 'basis',
        bovenkop: 'Diensten',
        kop: 'Twee kaarten',
        items: kolommen(2),
      },
      {
        type: 'citaten',
        achtergrond: 'mist',
        ruimte: 'sectie-l',
        breedte: 'basis',
        items: citaten(1),
      },
      {
        type: 'oproep',
        achtergrond: 'inkt',
        ruimte: 'sectie-l',
        breedte: 'basis',
        kop: 'Alleen een kop en een knop',
        knop: { label: 'Stuur maar', href: '/contact' },
      },
      {
        // Zonder sectiekop. De kopblokken zijn dan zelf het bovenste niveau en
        // horen <h2> te zijn; met een sectiekop erboven zakken ze naar <h3>.
        // Dat tweede geval staat in "te lange kop" en in "veel items".
        type: 'rijke-tekst',
        achtergrond: 'papier',
        ruimte: 'sectie-l',
        breedte: 'smal',
        inhoud: Markdoc.parse(
          `## Zonder sectiekop erboven\n\n${LOPENDE_TEKST}\n\n- Eerste punt\n- Tweede punt`,
        ),
      },
    ],
  },
  {
    naam: 'veel items · ontbrekend beeld',
    secties: [
      {
        // Lege bron: geen gebroken afbeelding, geen leeg kader. De hero valt
        // terug op het egale vlak en de schicht mag dan wél verschijnen.
        type: 'hero',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'breed',
        bovenkop: 'Zonder beeld',
        kop: 'Een van de 100',
        tekst: LANGE_TEKST,
        knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
        beeld: { bron: '', alt: '' },
        schicht: true,
      },
      {
        type: 'splitscreen',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'breed',
        deuren: [
          {
            bovenkop: 'Opdrachtgevers',
            kop: 'Zonder beeld',
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
          },
          {
            bovenkop: 'Professionals',
            kop: 'Ook zonder beeld',
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
          },
        ],
      },
      {
        type: 'kop-tekst',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Veel tekst',
        kop: 'Een gewone kop',
        tekst: LANGE_TEKST,
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'papier',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Zonder beeld',
        kop: 'De beeldkolom valt weg',
        tekst: LANGE_TEKST,
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'breed',
        kop: 'Acht kaarten',
        items: kolommen(8),
      },
      {
        type: 'citaten',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'breed',
        bovenkop: 'Wat ze zeggen',
        items: citaten(6),
      },
      {
        type: 'oproep',
        achtergrond: 'mist',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Aan de slag',
        kop: 'Twee acties naast elkaar',
        tekst: LANGE_TEKST,
        knop: { label: 'Ik zoek personeel', href: '/contact' },
        tweedeKnop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
      },
      {
        type: 'rijke-tekst',
        achtergrond: 'papier',
        ruimte: 'sectie-m',
        breedte: 'smal',
        kop: 'Algemene voorwaarden',
        schichtLijst: true,
        // Ook de inline-opmaak die het schema toelaat: vet, cursief en een
        // link. Zonder dit blijft die tak van de renderer ongetest.
        inhoud: Markdoc.parse(
          `${LANGE_TEKST}\n\n## Artikel 1 — Wie we zijn\n\n${LANGE_TEKST}\n\n- Eerste punt\n- Tweede punt\n- Derde punt\n- Vierde punt\n\n### Een kop een niveau dieper\n\n**Vet**, *cursief* en een [link naar contact](/contact).`,
        ),
      },
    ],
  },
  {
    naam: 'regressie · extreem lange kop in splitscreen',
    secties: [
      {
        type: 'splitscreen',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        deuren: [
          {
            bovenkop: 'Opdrachtgevers',
            kop: REGRESSIE_KOP,
            tekst: LANGE_TEKST,
            knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
            beeld: BEELD,
          },
          {
            bovenkop: 'Professionals',
            kop: REGRESSIE_KOP,
            tekst: LANGE_TEKST,
            knop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
            beeld: BEELD,
          },
        ],
      },
    ],
  },
  {
    /*
     * Regressie. Een staande foto van 1333x2000 in het liggende vlak van 16:9
     * verloor 63% van zijn hoogte, gemeten. Dat viel niet op omdat er geen
     * vervorming bij komt kijken — object-cover snijdt netjes weg — en op deze
     * fotografie snijdt het midden precies de hoofden eraf.
     *
     * De twee hieronder staan naast elkaar met dezelfde foto: links de vorm die
     * erbij hoort, rechts de standaard. Wijkt de linker af van 4:5, dan is de
     * verhoudingstabel in tokens.ts of de doorgave in BeeldTekst stuk.
     */
    naam: 'regressie · staande foto op 4:5 tegenover 16:9',
    secties: [
      {
        type: 'beeld-tekst',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Staand op 4:5',
        kop: 'De vorm die bij de foto past',
        tekst: LOPENDE_TEKST,
        beeld: STAAND_BEELD,
        verhouding: 'portret',
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Dezelfde foto op 16:9',
        kop: 'Wat de standaard ervan maakt',
        tekst: LOPENDE_TEKST,
        beeld: STAAND_BEELD,
        beeldPositie: 'rechts',
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Vierkant',
        kop: 'De derde uit de beeldrichtlijn',
        tekst: LOPENDE_TEKST,
        beeld: STAAND_BEELD,
        verhouding: 'vierkant',
      },
    ],
  },
  {
    /*
     * Regressie. Drie manieren waarop de koppenvolgorde stil sneuvelde toen het
     * kopniveau nog in de sectie zelf vastlag: geen h1, twee h1's, en een niveau
     * dat halverwege omhoog ging.
     *
     * SectieLijst berekent het niveau nu over de hele lijst. Deze drie gevallen
     * horen uit te komen op precies één h1, vooraan, zonder sprong.
     */
    naam: 'regressie · koppen zonder hero',
    secties: [
      {
        // Geen hero. Zonder de berekening had deze pagina nul h1 en begon ze
        // op h2; nu draagt de eerste sectie met een kop hem.
        type: 'kop-tekst',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Zonder openingssectie',
        kop: 'Deze kop opent de pagina',
        tekst: LOPENDE_TEKST,
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: 'En deze zakt naar h2',
        items: kolommen(2),
      },
    ],
  },
  {
    naam: 'regressie · twee openingssecties',
    secties: [
      {
        type: 'hero',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Eerste',
        kop: 'Deze blijft h1 en display-xl',
        tekst: LOPENDE_TEKST,
      },
      {
        // Tweede hero: geen tweede h1 en geen tweede display-xl. Hij zakt naar
        // een gewone sectiekop op display-l.
        type: 'hero',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Tweede',
        kop: 'Deze zakt naar h2 en display-l',
        tekst: LOPENDE_TEKST,
      },
    ],
  },
  {
    /*
     * De teller in de openingskop. Twee heroes naast elkaar: één met een getal
     * en één zonder.
     *
     * Waar je op let: in de broncode staat 100 en niet 0 — het script telt
     * ernaartoe, niet ervandaan. De kop mag niet wiebelen terwijl hij telt; de
     * breedte van drie cijfers is gereserveerd met --maat-teller plus
     * tabular-nums. En de kop zonder getal hoort geen extra elementen te
     * krijgen.
     */
    naam: 'teller · kop met en zonder getal',
    secties: [
      {
        type: 'hero',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Met getal',
        kop: 'Een van de 100',
        tekst: LOPENDE_TEKST,
      },
      {
        type: 'hero',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Zonder getal',
        kop: 'Honderd plekken',
        tekst: LOPENDE_TEKST,
      },
    ],
  },
  {
    naam: 'regressie · sectie met kop vóór de hero',
    secties: [
      {
        // Deze stond vroeger op h2 met de hero eronder op h1: het niveau ging
        // dan halverwege de pagina omhoog. Nu draagt deze de h1.
        type: 'drie-kolommen',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: 'Deze staat bovenaan en draagt de h1',
        items: kolommen(2),
      },
      {
        type: 'hero',
        achtergrond: 'inkt',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Verplaatst',
        kop: 'De hero staat nu tweede',
        tekst: LOPENDE_TEKST,
      },
    ],
  },
];
---

{/*
  Elk geval gaat als eigen lijst door SectieLijst, dus elk geval krijgt zijn
  eigen <h1>. Op een echte pagina zou dat fout zijn; hier is het de bedoeling,
  want elk geval ís een aparte pagina-in-het-klein. Deze pagina staat op
  noindex en telt niet mee in check-koppen.
*/}
<Basis titel="Sectieoverzicht — De Club van 100" noindex>
  {
    gevallen.map((geval) => (
      <>
        <p class="mx-auto max-w-breed px-marge pt-sectie-s text-bovenkop text-tekst-stil uppercase">
          {geval.naam}
        </p>
        <SectieLijst secties={geval.secties} />
      </>
    ))
  }
</Basis>
