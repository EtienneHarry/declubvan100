---
import Basis from '../layouts/Basis.astro';
import { SectieLijst, type Sectie } from '../lib/SectionRenderer';
import Knop, { type KnopVariant } from '../components/basis/Knop';
import Beeldvlak from '../components/beeld/Beeldvlak';
import Bovenkop from '../components/basis/Bovenkop';
import Ovaal from '../components/merk/Ovaal';
import Streep from '../components/merk/Streep';
import Markdoc from '@markdoc/markdoc';

import foto from '../assets/photo/proost-tap.jpg';

/*
 * Beheerbaarheidstest.
 *
 * Elk van de zeven sectietypes vier keer, onder de omstandigheden waar een
 * sjabloon normaal op stukloopt: een te lange kop, een lege tekst, weinig items
 * en veel items. Bij beeld-tekst en splitscreen komt op de vierde plek een
 * ontbrekende afbeelding in plaats van veel items.
 *
 * Niet elk type heeft items. Bij kop-tekst, beeld-tekst en oproep vertalen
 * "weinig" en "veel" zich naar de hoeveelheid tekst en het aantal optionele
 * onderdelen — dat is daar het equivalent van een leeg of overvol blok.
 *
 * De achtergrondtokens wisselen per geval, zodat zichtbaar wordt of secties in
 * willekeurige volgorde naast elkaar blijven kloppen en of het lichte thema
 * meekantelt.
 *
 * Onderaan staat een vijfde blok dat geen variant is maar een regressietest:
 * één splitscreen met een extreem lange kop, die de overflow-bug in Beeldvlak
 * moet blootleggen zodra iemand daar grid-cols-1 of w-full weghaalt.
 *
 * Daarna volgt "beweging": elk sectietype staat hier ver genoeg onder de vouw
 * om de scrollonthulling echt af te zien gaan, en één geval is er alleen voor
 * het ritme, het masker en de zoom.
 */

const LANGE_KOP =
  'Een kop die bewust veel te lang is gemaakt om te zien of hij netjes over meerdere regels afbreekt in plaats van uit zijn sectie te lopen of het raster op te rekken';

const LOPENDE_TEKST =
  'Iedereen die hier staat, heeft honderd avonden achter een bar gestaan. Wij regelen de mensen, jij regelt de rest.';

const LANGE_TEKST = `${LOPENDE_TEKST} ${LOPENDE_TEKST} ${LOPENDE_TEKST}`;

const BEELD = { bron: foto.src, alt: 'Twee mensen proosten aan de buitenbar' };

/*
 * Een staande foto, rechtstreeks uit public/beeld en dus langs Astro's
 * beeldpijplijn heen — precies zoals een foto die de redacteur in het CMS
 * kiest. Het merendeel van de aangeleverde fotografie is 1333x2000.
 */
const STAAND_BEELD = {
  bron: '/beeld/staff-wanted.jpg',
  alt: 'Aanplakbiljet met de tekst staff wanted tegen een muur',
};

/*
 * Regressie. Beeldvlak sneed inhoud af zolang het een vaste verhouding met
 * absoluut gepositioneerde tekst was: op 375px verdween hier 309px kop en tekst
 * boven de rand. De reparatie hangt aan grid-cols-1 en w-full in Beeldvlak, en
 * die zien er allebei weglaatbaar uit.
 *
 * Deze kop is expres extreem. Op 375px moet hij het vlak laten meegroeien —
 * niets afgesneden, niets buiten de viewport.
 */
const REGRESSIE_KOP =
  'Een kop die zo lang is dat hij op een telefoon acht of negen regels beslaat en daarmee ver voorbij de zestien-negen-verhouding van het beeldvlak groeit, wat precies de situatie is waarin de inhoud vroeger stilzwijgend werd weggeknipt in plaats van het vlak te laten meegroeien';

/*
 * De vijf knopvarianten. Als Record en niet als losse lijst: komt er in Knop
 * een variant bij, dan eist TypeScript hier een regel en kan hij niet stil
 * ongetest blijven.
 */
const KNOPVARIANTEN: Record<KnopVariant, string> = {
  vuur: 'Vuur — de primaire actie',
  inkt: 'Inkt — de zwarte knop',
  vol: 'Vol — wit, van vóór de restyle',
  lijn: 'Lijn — secundair',
  kaal: 'Kaal — tertiair',
};

function kolommen(aantal: number, metTekst = true) {
  return Array.from({ length: aantal }, (_, index) => ({
    nummer: String(index + 1).padStart(2, '0'),
    kop: `Kaart ${index + 1}`,
    tekst: metTekst ? 'Tappen onder druk, cocktails, opbouw en afbouw.' : '',
  }));
}

function citaten(aantal: number) {
  return Array.from({ length: aantal }, (_, index) => ({
    citaat: `Ze stonden er op tijd en ze wisten wat ze deden. Citaat ${index + 1}.`,
    naam: `Opdrachtgever ${index + 1}`,
    rol: 'Festivalorganisatie',
  }));
}

const gevallen: { naam: string; secties: Sectie[] }[] = [
  {
    naam: 'te lange kop',
    secties: [
      {
        type: 'hero',
        achtergrond: 'bruin',
        ruimte: 'sectie-l',
        breedte: 'basis',
        bovenkop: 'Een bovenkop die ook al aan de lange kant is',
        kop: LANGE_KOP,
        tekst: LOPENDE_TEKST,
        knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
        tweedeKnop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
        schicht: true,
      },
      {
        type: 'splitscreen',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        deuren: [
          {
            bovenkop: 'Opdrachtgevers',
            kop: LANGE_KOP,
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
            beeld: BEELD,
          },
          {
            bovenkop: 'Professionals',
            kop: LANGE_KOP,
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
            beeld: BEELD,
          },
        ],
      },
      {
        type: 'kop-tekst',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Over ons',
        kop: LANGE_KOP,
        tekst: LOPENDE_TEKST,
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Werkwijze',
        kop: LANGE_KOP,
        tekst: LOPENDE_TEKST,
        beeld: BEELD,
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'papier',
        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: LANGE_KOP,
        items: kolommen(3),
      },
      {
        type: 'citaten',
        achtergrond: 'mist',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Wat ze zeggen',
        items: [{ citaat: LANGE_KOP, naam: 'Een opdrachtgever', rol: 'Horeca' }],
