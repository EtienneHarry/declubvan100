      },
      {
        type: 'kop-tekst',
        achtergrond: 'papier',
        ruimte: 'sectie-l',
        breedte: 'smal',
        kop: 'Alleen een kop',
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'roet',
        ruimte: 'sectie-l',
        breedte: 'basis',
        kop: 'Alleen een kop en beeld',
        beeld: BEELD,
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'bruin',
        ruimte: 'sectie-l',
        breedte: 'basis',
        bovenkop: 'Diensten',
        kop: 'Twee kaarten',
        items: kolommen(2),
      },
      {
        type: 'citaten',
        achtergrond: 'mist',
        ruimte: 'sectie-l',
        breedte: 'basis',
        items: citaten(1),
      },
      {
        type: 'oproep',
        achtergrond: 'bruin',
        ruimte: 'sectie-l',
        breedte: 'basis',
        kop: 'Alleen een kop en een knop',
        knop: { label: 'Stuur maar', href: '/contact' },
      },
      {
        // Zonder sectiekop. De kopblokken zijn dan zelf het bovenste niveau en
        // horen <h2> te zijn; met een sectiekop erboven zakken ze naar <h3>.
        // Dat tweede geval staat in "te lange kop" en in "veel items".
        type: 'rijke-tekst',
        achtergrond: 'papier',
        ruimte: 'sectie-l',
        breedte: 'smal',
        inhoud: Markdoc.parse(
          `## Zonder sectiekop erboven\n\n${LOPENDE_TEKST}\n\n- Eerste punt\n- Tweede punt`,
        ),
      },
    ],
  },
  {
    naam: 'veel items · ontbrekend beeld',
    secties: [
      {
        // Lege bron: geen gebroken afbeelding, geen leeg kader. De hero valt
        // terug op het egale vlak en de schicht mag dan wél verschijnen.
        type: 'hero',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'breed',
        bovenkop: 'Zonder beeld',
        kop: 'Een van de 100',
        tekst: LANGE_TEKST,
        knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
        beeld: { bron: '', alt: '' },
        schicht: true,
      },
      {
        type: 'splitscreen',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'breed',
        deuren: [
          {
            bovenkop: 'Opdrachtgevers',
            kop: 'Zonder beeld',
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
          },
          {
            bovenkop: 'Professionals',
            kop: 'Ook zonder beeld',
            tekst: LOPENDE_TEKST,
            knop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
          },
        ],
      },
      {
        type: 'kop-tekst',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Veel tekst',
        kop: 'Een gewone kop',
        tekst: LANGE_TEKST,
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'papier',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Zonder beeld',
        kop: 'De beeldkolom valt weg',
        tekst: LANGE_TEKST,
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'breed',
        kop: 'Acht kaarten',
        items: kolommen(8),
      },
      {
        type: 'citaten',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'breed',
        bovenkop: 'Wat ze zeggen',
        items: citaten(6),
      },
      {
        type: 'oproep',
        achtergrond: 'mist',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Aan de slag',
        kop: 'Twee acties naast elkaar',
        tekst: LANGE_TEKST,
        knop: { label: 'Ik zoek personeel', href: '/contact' },
        tweedeKnop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
      },
      {
        type: 'rijke-tekst',
        achtergrond: 'papier',
        ruimte: 'sectie-m',
        breedte: 'smal',
        kop: 'Algemene voorwaarden',
        schichtLijst: true,
        // Ook de inline-opmaak die het schema toelaat: vet, cursief en een
        // link. Zonder dit blijft die tak van de renderer ongetest.
        inhoud: Markdoc.parse(
          `${LANGE_TEKST}\n\n## Artikel 1 — Wie we zijn\n\n${LANGE_TEKST}\n\n- Eerste punt\n- Tweede punt\n- Derde punt\n- Vierde punt\n\n### Een kop een niveau dieper\n\n**Vet**, *cursief* en een [link naar contact](/contact).`,
        ),
      },
    ],
  },
  {
    naam: 'regressie · extreem lange kop in splitscreen',
    secties: [
      {
        type: 'splitscreen',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        deuren: [
          {
            bovenkop: 'Opdrachtgevers',
            kop: REGRESSIE_KOP,
            tekst: LANGE_TEKST,
            knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
            beeld: BEELD,
          },
          {
            bovenkop: 'Professionals',
            kop: REGRESSIE_KOP,
            tekst: LANGE_TEKST,
            knop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
            beeld: BEELD,
          },
        ],
      },
    ],
  },
  {
    /*
     * Regressie. Een staande foto van 1333x2000 in het liggende vlak van 16:9
     * verloor 63% van zijn hoogte, gemeten. Dat viel niet op omdat er geen
     * vervorming bij komt kijken — object-cover snijdt netjes weg — en op deze
     * fotografie snijdt het midden precies de hoofden eraf.
     *
     * De twee hieronder staan naast elkaar met dezelfde foto: links de vorm die
     * erbij hoort, rechts de standaard. Wijkt de linker af van 4:5, dan is de
     * verhoudingstabel in tokens.ts of de doorgave in BeeldTekst stuk.
     */
    naam: 'regressie · staande foto op 4:5 tegenover 16:9',
    secties: [
      {
        type: 'beeld-tekst',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Staand op 4:5',
        kop: 'De vorm die bij de foto past',
        tekst: LOPENDE_TEKST,
        beeld: STAAND_BEELD,
        verhouding: 'portret',
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Dezelfde foto op 16:9',
        kop: 'Wat de standaard ervan maakt',
        tekst: LOPENDE_TEKST,
        beeld: STAAND_BEELD,
        beeldPositie: 'rechts',
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'roet',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Vierkant',
        kop: 'De derde uit de beeldrichtlijn',
        tekst: LOPENDE_TEKST,
        beeld: STAAND_BEELD,
        verhouding: 'vierkant',
      },
    ],
  },
  {
    /*
     * Regressie. Drie manieren waarop de koppenvolgorde stil sneuvelde toen het
     * kopniveau nog in de sectie zelf vastlag: geen h1, twee h1's, en een niveau
     * dat halverwege omhoog ging.
     *
     * SectieLijst berekent het niveau nu over de hele lijst. Deze drie gevallen
     * horen uit te komen op precies één h1, vooraan, zonder sprong.
     */
    naam: 'regressie · koppen zonder hero',
    secties: [
      {
        // Geen hero. Zonder de berekening had deze pagina nul h1 en begon ze
        // op h2; nu draagt de eerste sectie met een kop hem.
        type: 'kop-tekst',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Zonder openingssectie',
        kop: 'Deze kop opent de pagina',
        tekst: LOPENDE_TEKST,
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: 'En deze zakt naar h2',
