---
import Basis from '../layouts/Basis.astro';
import SectionRenderer, { type Sectie } from '../lib/SectionRenderer';
import cocktailBar from '../assets/photo/cocktail-bar.jpg';

/*
 * De 100.
 *
 * Toon: directer en uitdagender. Nadruk op erbij horen, op de betere klussen
 * en op wie er niet doorkomt.
 *
 * De drie merkwaarden staan in bron als drie woorden en verder niets. De
 * kaarten dragen daarom alleen die woorden; er is geen omschrijving bij
 * verzonnen. Zodra de klant er een zin bij levert, past die in `tekst`.
 *
 * Schichten op deze pagina: één, de grote in de hero. De opsommingsschicht zou
 * hier passen bij een lijst over de selectie, maar drie is het maximum voor een
 * hele pagina en die raak je met één lijst meteen kwijt.
 */

const secties: Sectie[] = [
  {
    type: 'hero',
    achtergrond: 'inkt',
    ruimte: 'sectie-l',
    breedte: 'basis',
    bovenkop: 'De 100',
    kop: 'Honderd plekken',
    tekst: 'Je hoort erbij of je hoort er niet bij.',
    schicht: true,
  },
  {
    type: 'beeld-tekst',
    achtergrond: 'inkt',
    ruimte: 'sectie-m',
    breedte: 'basis',
    bovenkop: 'Wie erin zitten',
    kop: 'Geen standaard uitzendkrachten',
    tekst: 'Iedereen die hier staat, heeft honderd avonden achter een bar gestaan.',
    beeld: {
      bron: cocktailBar.src,
      alt: 'Iemand maakt een cocktail achter de buitenbar',
    },
    beeldPositie: 'rechts',
  },
  {
    type: 'kop-tekst',
    achtergrond: 'inkt',
    ruimte: 'sectie-m',
    breedte: 'basis',
    bovenkop: 'Waarom honderd',
    kop: 'Het is de grens.',
    tekst:
      'Honderd is geen willekeurig getal. Zit de honderd vol, dan bellen we als er een plek vrijkomt.',
  },
  {
    type: 'drie-kolommen',
    achtergrond: 'inkt',
    ruimte: 'sectie-m',
    breedte: 'basis',
    kop: 'Enthousiast, ervaren, trots',
    items: [
      { nummer: '01', kop: 'Enthousiast' },
      { nummer: '02', kop: 'Ervaren' },
      { nummer: '03', kop: 'Trots' },
    ],
  },
  {
    type: 'oproep',
    achtergrond: 'inkt',
    ruimte: 'sectie-l',
    breedte: 'basis',
    bovenkop: 'Meld je',
    kop: 'Niet iedereen komt erdoor.',
    tekst:
      'Denk je dat jij een van de betere barmannen van de stad bent, laat het weten.',
    knop: { label: 'Ik wil bij jullie werken', href: '/contact' },
  },
];
---

<Basis
  titel="De 100 — De Club van 100"
  beschrijving="Honderd plekken. Niet iedereen komt erdoor. Iedereen die hier staat, heeft honderd avonden achter een bar gestaan."
>
  {secties.map((sectie) => <SectionRenderer sectie={sectie} />)}
</Basis>
